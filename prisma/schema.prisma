generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NewsletterSubscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(254)
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(254)
  subject   String   @db.VarChar(200)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model Inquiry {
  id                    Int      @id @default(autoincrement())
  fullName              String   @map("full_name") @db.VarChar(100)
  companyName           String   @map("company_name") @db.VarChar(200)
  jobTitle              String?  @map("job_title") @db.VarChar(100)
  businessEmail         String   @map("business_email") @db.VarChar(254)
  phoneNumber           String   @map("phone_number") @db.VarChar(30)
  companyWebsite        String?  @map("company_website") @db.VarChar(255)
  country               String   @db.VarChar(100)
  city                  String?  @db.VarChar(100)
  shippingCountry       String   @map("shipping_country") @db.VarChar(100)
  inquiryType           String   @map("inquiry_type") @db.VarChar(50)
  companyType           String   @map("company_type") @db.VarChar(50)
  coffeeType            String   @map("coffee_type") @db.VarChar(50)
  processingMethod      String?  @map("processing_method") @db.VarChar(50)
  preferredOrigin       String?  @map("preferred_origin") @db.VarChar(50)
  grade                 String?  @db.VarChar(50)
  harvestPreference     String?  @map("harvest_preference") @db.VarChar(100)
  quantityType          String   @map("quantity_type") @db.VarChar(20)
  quantityRange         String?  @map("quantity_range") @db.VarChar(50)
  quantityKg            Int?     @map("quantity_kg")
  quantityBags          Int?     @map("quantity_bags")
  incoterm              String?  @db.VarChar(20)
  deliveryDate          String?  @map("delivery_date") @db.VarChar(30)
  preferredPort         String?  @map("preferred_port") @db.VarChar(100)
  additionalRequirements String? @map("additional_requirements") @db.Text
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("inquiries")
}